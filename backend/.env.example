# Секретный ключ для подписи JWT токенов (ОБЯЗАТЕЛЬНЫЙ)
# Минимальная длина: 32 символа. Без валидного значения сервер не стартует.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-key-here

# Срок жизни access-токена (короткий). Формат jsonwebtoken: 15m, 1h, 30s
ACCESS_TOKEN_EXPIRES_IN=15m

# Срок жизни refresh-токена в миллисекундах (30 дней по умолчанию)
REFRESH_TOKEN_EXPIRES_MS=2592000000

# Rate-limiting для /api/auth/login и /api/auth/register
# Окно в миллисекундах (по умолчанию 15 минут)
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Максимум запросов с одного IP в окне (по умолчанию 10)
AUTH_RATE_LIMIT_MAX=10
